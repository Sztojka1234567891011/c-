using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace objektumok
{
    internal class diák
    {

        private const string iskola = "PG";
        private string SNI { get; set; }
        private double testsúly { get; set; }
        private bool uszásTudás { get; set; }
        
        public string neve { get; set; }
        public DateTime születésiDátum { get; set; }
        public int évfolyam{ get; set; }
        
        public diák(string line)
        {
            string[] adatok = line.Split(';');
            
            this.neve = adatok[0];
            this.SNI = adatok[1];
            this.testsúly = double.Parse(adatok[2]);
            this.uszásTudás = bool.Parse(adatok[3]);
            this.születésiDátum = DateTime.Parse(adatok[4]);
            this.évfolyam = int.Parse(adatok[5]);
        }
        public void kiegészítés(string szoveg, double súly, bool usz)
        {
        this.SNI = szoveg;
        this.testsúly = súly;
        this.uszásTudás = usz;
        }
        public bool tudeuszni() 
        {
            return uszásTudás;
        }
        public void szépkiírás() 
        {
            Console.BackgroundColor = ConsoleColor.Green;
            Console.ForegroundColor = ConsoleColor.Magenta;

            Console.WriteLine($"A diák neve: {neve}\n\tSNI: {SNI}\n\tTestsúly: {testsúly}");
            Console.ResetColor();


        }
        public int életkor()
        {
            DateTime maiNap = DateTime.Now;
            int életkor = maiNap.Year - születésiDátum.Year;
            if (maiNap < születésiDátum.AddYears(életkor))
            {
                életkor--;
            }
            return életkor;
        }

        public override string ToString()
        {
            return $"A diák neve: {neve}\n\tSNI: {SNI}\n\tTestsúly: {testsúly}";
        }
        
    }
}
